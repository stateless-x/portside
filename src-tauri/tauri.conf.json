{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Portside",
  "mainBinaryName": "Portside",
  "version": "0.0.1",
  "identifier": "dev.purin.portwatch",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Portside",
        "width": 380,
        "height": 520,
        "visible": false,
        "transparent": true,
        "windowEffects": {
          "effects": ["popover"]
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
